{
  "name": "vicion-bot",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/bot"
  ],
  "scripts": {
    "test": "npm test --workspace apps/bot",
    "build": "npm run build --workspace apps/bot",
    "typecheck": "npm run typecheck --workspace apps/bot",
    "build:scripts": "tsc -p apps/bot/scripts/tsconfig.json",
    "backtest:casper": "npm run build:scripts && node apps/bot/scripts-dist/scripts/runCasperBacktest.js",
    "audit:casper-reality": "npm run build:scripts && node apps/bot/scripts-dist/scripts/auditCasperReality.js",
    "fetch-ohlcv": "npm run build:scripts && node apps/bot/scripts-dist/scripts/fetchOhlcv.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vitest": "^4.1.11"
  }
}
