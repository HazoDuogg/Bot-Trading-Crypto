//@version=6
strategy("Trend Join L/S - BTCUSDT v2e (Fixed TP)", shorttitle="TJL v2e TP", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=1, calc_on_every_tick=false, process_orders_on_close=true,
     margin_long=100, margin_short=100)

// =============================================================================
// Trend Join L/S v2e - FINALIZED working Fixed-TP version, built on top of
// v2c (bufferMult=0.5, LOCKED IN). Entry logic is byte-identical to v2c -
// not touched. v2c itself is untouched by this file, kept as the trailing-
// exit control alongside the plain v2 baseline.
//
// GOAL SHIFT: prior variants (v2b/v2c/v2d) all changed the ENTRY side and
// kept v1/v2's chandelier-trail exit (ATR initial stop, then trail tightens
// as highest/lowest-since-entry moves) - built for letting winners run. The
// actual goal here is different: frequent, short-duration trades with a
// solid win rate and wins bigger than losses, not maximizing single-trade
// size.
//
// CHANGE: replace the chandelier trail entirely with a FIXED take-profit at
// a defined R:R, where R = the initial stop distance (1.5x ATR, same basis
// as before). Once either the stop or the take-profit is hit, the trade is
// closed - no trailing. Single strategy.exit() bracket (stop + limit)
// placed once at entry, not recalculated bar-by-bar.
//
// Status: rrMult=2.25 is LOCKED IN as the working value. Full curve tested
// on Jul1-Sep20 2026 (Combined trades / PF / net P&L):
//   R:R 1.50:              61 trades, PF 0.88, net -$44.11
//   R:R 1.75:              58 trades, PF 1.04, net +$14.15
//   R:R 2.00:              54 trades, PF 1.11, net +$38.60
//   R:R 2.25 (LOCKED IN):  52 trades, PF 1.27, net +$87.02
//   R:R 3.00:              42 trades, PF 0.97, net -$8.84 (Short avg
//                          duration blows out to 540min on just 18 trades -
//                          looked like outlier-driven noise, not real
//                          structure)
// PF rises monotonically 1.5->2.25 then falls sharply by 3.0, so the true
// peak sits somewhere between 2.25-3.0 - deliberately NOT chased further:
// (a) the 3.0 cliff looks noise-driven on a small sample, and (b) this is
// the second parameter swept on this same window (after the ATR buffer),
// and each additional search on unchanged data raises overfitting risk.
// 2.25 is a clear, consistent improvement over baseline on every metric
// (win rate, PF, net P&L, AND avg duration) - enough to lock in.
//
// At rrMult=2.25 (Jul1-Sep20 2026): Long 29 trades/51.7% win/PF 1.40/avgDur
// 112min; Short 23 trades/47.8% win/PF 1.04/avgDur 119min (Short's first
// time clearing PF 1.0 across every variant tested so far).
//
// NEXT STEP: real validation is forward/paper-testing on fresh data, not
// further tuning here - see tjl_btcusdt_three_variant_scanner.sh, which
// runs this variant (buffer+RR2.25) alongside the v2 baseline and v2c
// buffer-only variant in parallel.
// =============================================================================

// ---- Inputs ----
grpExit = "Exit Settings"
atrLen             = input.int(14, "ATR Length", group=grpExit)
initialStopAtrMult = input.float(1.5, "Initial Stop - ATR Multiplier (defines R)", minval=0.1, step=0.1, group=grpExit)
rrMult             = input.float(2.25, "Take-Profit R:R Multiple", minval=0.1, step=0.1, group=grpExit)

grpDaily = "Daily Trend Filter"
smaLen = input.int(200, "Daily SMA Length", group=grpDaily)

grpShort = "Short Entry Filter"
bufferMult = input.float(0.5, "Intraday Breakdown - ATR Buffer Multiplier", minval=0.0, step=0.05, group=grpShort)

// ---- Daily-context data (previous COMPLETED daily bar only, no repainting) ----
// Verified directly against the live deployed v1/v2 strategies: this [1]
// offset pattern correctly resolves to YESTERDAY's completed daily bar (a
// 1-day lag), not 2 days. Unchanged from v2/v2c.
dHigh1    = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
dLow1     = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
dClose1   = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
dSma200_1 = request.security(syminfo.tickerid, "D", ta.sma(close, smaLen)[1], lookahead=barmerge.lookahead_off)

// ---- Intraday session high/low since 00:00 UTC today (15m timeframe) ----
// Unchanged from v2/v2c.
utcYear  = year(time, "UTC")
utcMonth = month(time, "UTC")
utcDay   = dayofmonth(time, "UTC")
newUtcDay = utcDay != utcDay[1] or utcMonth != utcMonth[1] or utcYear != utcYear[1]

var float sessionHigh = na
var float sessionLow  = na
if newUtcDay
    sessionHigh := na
    sessionLow  := na

sessionHighExclCurrent = sessionHigh
sessionLowExclCurrent  = sessionLow
sessionHigh := math.max(nz(sessionHigh, high), high)
sessionLow  := math.min(nz(sessionLow, low), low)

// ---- Entry logic (byte-identical to v2c) ----
currPx = close
atrVal = ta.atr(atrLen)

// LONG SIDE: byte-identical to v1/v2/v2c - not touched.
dailyBreakout    = currPx > dHigh1 and dClose1 > dSma200_1
intradayBreakout = not na(sessionHighExclCurrent) and currPx > sessionHighExclCurrent
longCondition    = dailyBreakout and intradayBreakout

// SHORT SIDE: v2c's ATR buffer, unchanged.
dailyBreakdown = currPx < dLow1 and dClose1 < dSma200_1
intradayBreakdown = not na(sessionLowExclCurrent) and not na(atrVal) and
     currPx < sessionLowExclCurrent - bufferMult * atrVal
shortCondition = dailyBreakdown and intradayBreakdown

flat = strategy.position_size == 0

// ---- Exit logic: FIXED stop + take-profit bracket, no trailing. ----
// R = initialStopAtrMult * atrVal (the initial stop distance). Take-profit
// is entry +/- rrMult * R. Both are set ONCE at entry time and left alone -
// unlike the chandelier trail, nothing here recalculates bar-by-bar, so a
// trade only ever closes via whichever side of the bracket price reaches
// first.
if flat and longCondition and not na(atrVal)
    strategy.entry("Long", strategy.long)
    rDist = initialStopAtrMult * atrVal
    stopPrice = currPx - rDist
    tpPrice   = currPx + rrMult * rDist
    strategy.exit("Exit Long", "Long", stop=stopPrice, limit=tpPrice)
else if flat and shortCondition and not na(atrVal)
    strategy.entry("Short", strategy.short)
    rDist = initialStopAtrMult * atrVal
    stopPrice = currPx + rDist
    tpPrice   = currPx - rrMult * rDist
    strategy.exit("Exit Short", "Short", stop=stopPrice, limit=tpPrice)

// ---- Plots ----
plot(dHigh1, "Prev Daily High", color=color.new(color.red, 0), style=plot.style_stepline)
plot(dLow1, "Prev Daily Low", color=color.new(color.green, 0), style=plot.style_stepline)
plot(dSma200_1, "Daily SMA200 (prev)", color=color.new(color.blue, 0), linewidth=2)
plot(sessionHigh, "Session High (today, UTC)", color=color.new(color.orange, 0), style=plot.style_stepline)
plot(sessionLow, "Session Low (today, UTC)", color=color.new(color.purple, 0), style=plot.style_stepline)

plotshape(flat and longCondition, title="Long Entry",
     location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small)
plotshape(flat and shortCondition, title="Short Entry",
     location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small)

alertcondition(flat and longCondition, title="TJL Long Entry",
     message="Trend Join Long/Short v2e: BTCUSDT long entry conditions met")
alertcondition(flat and shortCondition, title="TJL Short Entry (fixed TP)",
     message="Trend Join Long/Short v2e: BTCUSDT ATR-buffer short entry conditions met")
