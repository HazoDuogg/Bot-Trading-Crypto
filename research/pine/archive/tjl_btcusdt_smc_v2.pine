//@version=6
strategy("SMC BTCUSDT v2 (Phase 2: +Trend Structure Filter)", shorttitle="SMC v2 P2", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=1, calc_on_every_tick=false, process_orders_on_close=true,
     margin_long=100, margin_short=100)

// =============================================================================
// SMC BTCUSDT v2 - Phase 2 addition on top of Phase 1 (tjl_btcusdt_smc_v1).
// Phase 1 result (full history, Daily): Long PF rose monotonically with R:R
// (0.58 -> 1.26 at RR5.0, 14 trades), but ALL 6 Short trades lost - every one
// stopped out within 3-12 days. Diagnostic on the 6 Short trades found every
// one fired during an uptrend/recovery regime (Jul 2018 dead-cat bounce, Mar
// 2020 post-COVID V-recovery, Oct 2021 blow-off-top rally, Jan 2023 recovery
// off FTX lows, Dec 2023 mid-bull-run, Aug 2026 near highs) - zero fired in a
// genuine sustained downtrend. Same mechanism as TJL v2 baseline's original
// Short problem (breakout shorts firing in chop/uptrend). Confirms this is a
// general BTC-Short principle, not specific to one entry style: Shorts need a
// real trend-context gate.
//
// PHASE 2 CHANGE: add TJL v3's trend-structure filter, unchanged in spirit -
//   - Structure: last two confirmed pivot highs/lows must show HH+HL
//     (uptrend) or LH+LL (downtrend). Anything else = no filter pass either
//     direction.
//   - SMA slope: SMA(smaLen) must be rising (uptrend) or falling (downtrend)
//     over slopeLookback bars, agreeing with the pivot-structure read.
// Applied SYMMETRICALLY: Short zones require structureDown+slopeFalling,
// Long zones require structureUp+slopeRising (Long wasn't filtered in Phase
// 1 - this checks whether the same gate helps, is neutral, or hurts it).
// Everything else (zone detection, discount/premium, liquidity sweep, entry,
// fixed R:R exit) is byte-identical to v1 - not touched.
// =============================================================================

// ---- Inputs ----
grpZone = "Zone Detection"
dispAtrMult     = input.float(1.5, "Displacement Move - Min ATR Multiple", minval=0.1, step=0.1, group=grpZone)
smallBodyRatio  = input.float(0.4, "Max Body/Range Ratio for Consolidation Candle", minval=0.05, step=0.05, group=grpZone)
maxZones        = input.int(15, "Max Stored Zones per Side", minval=2, group=grpZone)

grpFilter = "Discount/Premium + Liquidity Filters"
legLookback  = input.int(20, "Local Leg Lookback (bars)", minval=5, group=grpFilter)
eqLookback   = input.int(10, "Prior Liquidity Cluster Lookback (bars)", minval=3, group=grpFilter)
sweepWindow  = input.int(3, "Liquidity Sweep Window (bars before/at retest)", minval=1, group=grpFilter)

grpTrend = "Trend Structure Filter (Phase 2)"
pivotLen      = input.int(3, "Pivot Lookback (bars each side)", minval=1, group=grpTrend)
smaLen        = input.int(50, "SMA Length (slope filter)", minval=2, group=grpTrend)
slopeLookback = input.int(10, "SMA Slope Lookback (bars)", minval=1, group=grpTrend)

grpExit = "Exit Settings"
atrLen             = input.int(14, "ATR Length", group=grpExit)
stopBufferAtrMult  = input.float(0.25, "Stop Buffer Beyond Zone Edge (x ATR)", minval=0.0, step=0.05, group=grpExit)
rrMult             = input.float(5.0, "Take-Profit R:R Multiple", minval=0.1, step=0.1, group=grpExit)

atrVal = ta.atr(atrLen)

// ---- Zone detection: single consolidation candle right before a
// displacement move (byte-identical to v1). ----
bodyRange = high[1] - low[1]
isSmallBody = bodyRange > 0 and math.abs(close[1] - open[1]) <= smallBodyRatio * bodyRange
dispUp   = isSmallBody and not na(atrVal) and (close - close[1]) >= dispAtrMult * atrVal
dispDown = isSmallBody and not na(atrVal) and (close[1] - close) >= dispAtrMult * atrVal

var array<float> demandLo = array.new_float(0)
var array<float> demandHi = array.new_float(0)
var array<bool>  demandUsed = array.new_bool(0)
var array<float> supplyLo = array.new_float(0)
var array<float> supplyHi = array.new_float(0)
var array<bool>  supplyUsed = array.new_bool(0)

if dispUp
    array.push(demandLo, low[1])
    array.push(demandHi, high[1])
    array.push(demandUsed, false)
    if array.size(demandLo) > maxZones
        array.shift(demandLo)
        array.shift(demandHi)
        array.shift(demandUsed)
if dispDown
    array.push(supplyLo, low[1])
    array.push(supplyHi, high[1])
    array.push(supplyUsed, false)
    if array.size(supplyLo) > maxZones
        array.shift(supplyLo)
        array.shift(supplyHi)
        array.shift(supplyUsed)

// ---- Discount/Premium: local leg re-anchoring (byte-identical to v1). ----
legLow  = ta.lowest(low, legLookback)
legHigh = ta.highest(high, legLookback)
legMid  = (legLow + legHigh) / 2
inDiscount = close < legMid
inPremium  = close >= legMid

// ---- Liquidity sweep: N-bar window (byte-identical to v1). ----
priorLowCluster  = ta.lowest(low[sweepWindow], eqLookback)
recentLow        = ta.lowest(low, sweepWindow)
sweptLiquidityLow = recentLow < priorLowCluster

priorHighCluster  = ta.highest(high[sweepWindow], eqLookback)
recentHigh        = ta.highest(high, sweepWindow)
sweptLiquidityHigh = recentHigh > priorHighCluster

// ---- Trend structure filter (Phase 2 addition, mirrors TJL v3). ----
phVal = ta.pivothigh(pivotLen, pivotLen)
plVal = ta.pivotlow(pivotLen, pivotLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(phVal)
    prevPH := lastPH
    lastPH := phVal
if not na(plVal)
    prevPL := lastPL
    lastPL := plVal

structureUp   = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and
     lastPH > prevPH and lastPL > prevPL
structureDown = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and
     lastPH < prevPH and lastPL < prevPL

smaVal      = ta.sma(close, smaLen)
slopeRising  = smaVal > smaVal[slopeLookback]
slopeFalling = smaVal < smaVal[slopeLookback]

allowLong  = structureUp and slopeRising
allowShort = structureDown and slopeFalling

flat = strategy.position_size == 0

// ---- Entry: zone retest + rejection, now gated by the trend filter. ----
var float pendingStop = na
longTrigger = false
shortTrigger = false

if flat and array.size(demandLo) > 0
    for i = array.size(demandLo) - 1 to 0
        if not array.get(demandUsed, i)
            zLo = array.get(demandLo, i)
            zHi = array.get(demandHi, i)
            touched = low <= zHi and high >= zLo
            rejection = touched and close > zHi and close > open
            if rejection and inDiscount and sweptLiquidityLow and allowLong
                array.set(demandUsed, i, true)
                longTrigger := true
                pendingStop := zLo - stopBufferAtrMult * atrVal
                break

if flat and array.size(supplyLo) > 0
    for i = array.size(supplyLo) - 1 to 0
        if not array.get(supplyUsed, i)
            zLo = array.get(supplyLo, i)
            zHi = array.get(supplyHi, i)
            touched = high >= zLo and low <= zHi
            rejection = touched and close < zLo and close < open
            if rejection and inPremium and sweptLiquidityHigh and allowShort
                array.set(supplyUsed, i, true)
                shortTrigger := true
                pendingStop := zHi + stopBufferAtrMult * atrVal
                break

if flat and longTrigger and not na(atrVal)
    strategy.entry("Long", strategy.long)
    rDist = close - pendingStop
    tpPrice = close + rrMult * rDist
    strategy.exit("Exit Long", "Long", stop=pendingStop, limit=tpPrice)
else if flat and shortTrigger and not na(atrVal)
    strategy.entry("Short", strategy.short)
    rDist = pendingStop - close
    tpPrice = close - rrMult * rDist
    strategy.exit("Exit Short", "Short", stop=pendingStop, limit=tpPrice)

// ---- Plots ----
plot(legHigh, "Local Leg High", color=color.new(color.orange, 0), style=plot.style_stepline)
plot(legMid, "Local Leg 50% (Discount/Premium)", color=color.new(color.yellow, 0), style=plot.style_stepline)
plot(legLow, "Local Leg Low", color=color.new(color.orange, 0), style=plot.style_stepline)
plot(smaVal, "SMA (slope filter)", color=color.new(color.blue, 0), linewidth=2)

plotshape(dispUp, title="New Demand Zone", location=location.belowbar, style=shape.square, color=color.new(color.lime, 40), size=size.tiny)
plotshape(dispDown, title="New Supply Zone", location=location.abovebar, style=shape.square, color=color.new(color.red, 40), size=size.tiny)
plotshape(longTrigger, title="Long Entry", location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small)
plotshape(shortTrigger, title="Short Entry", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small)

bgcolor(structureUp ? color.new(color.green, 92) : structureDown ? color.new(color.red, 92) : na, title="Structure background")

alertcondition(longTrigger, title="SMC Long Entry", message="SMC v2: BTCUSDT demand-zone retest long entry (trend-filtered)")
alertcondition(shortTrigger, title="SMC Short Entry", message="SMC v2: BTCUSDT supply-zone retest short entry (trend-filtered)")

// ---- Debug: per-side breakdown via data_get_study_values (temporary,
// same technique used for the TJL v2e R:R sweep and SMC v1). ----
longTrades = 0
longWins = 0
longGP = 0.0
longGL = 0.0
longDurSum = 0.0
shortTrades = 0
shortWins = 0
shortGP = 0.0
shortGL = 0.0
shortDurSum = 0.0

for i = 0 to strategy.closedtrades - 1
    isLongT = strategy.closedtrades.size(i) > 0
    profit = strategy.closedtrades.profit(i)
    dur = strategy.closedtrades.exit_time(i) - strategy.closedtrades.entry_time(i)
    if isLongT
        longTrades += 1
        longDurSum += dur
        if profit > 0
            longWins += 1
            longGP += profit
        else
            longGL += -profit
    else
        shortTrades += 1
        shortDurSum += dur
        if profit > 0
            shortWins += 1
            shortGP += profit
        else
            shortGL += -profit

longPF = longGL > 0 ? longGP / longGL : 0.0
shortPF = shortGL > 0 ? shortGP / shortGL : 0.0
longAvgDurDays = longTrades > 0 ? longDurSum / longTrades / 1000 / 60 / 60 / 24 : 0.0
shortAvgDurDays = shortTrades > 0 ? shortDurSum / shortTrades / 1000 / 60 / 60 / 24 : 0.0
longWinPct = longTrades > 0 ? longWins / longTrades * 100 : 0.0
shortWinPct = shortTrades > 0 ? shortWins / shortTrades * 100 : 0.0

plot(longTrades, "Z_LongTrades", display=display.data_window)
plot(longWinPct, "Z_LongWinPct", display=display.data_window)
plot(longPF, "Z_LongPF", display=display.data_window)
plot(longAvgDurDays, "Z_LongAvgDurDays", display=display.data_window)
plot(shortTrades, "Z_ShortTrades", display=display.data_window)
plot(shortWinPct, "Z_ShortWinPct", display=display.data_window)
plot(shortPF, "Z_ShortPF", display=display.data_window)
plot(shortAvgDurDays, "Z_ShortAvgDurDays", display=display.data_window)
