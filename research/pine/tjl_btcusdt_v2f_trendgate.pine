//@version=6
strategy("Trend Join L/S - BTCUSDT v2f (Trend-Structure Gate)", shorttitle="TJL v2f TG", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=1, calc_on_every_tick=false, process_orders_on_close=true,
     margin_long=100, margin_short=100)

// =============================================================================
// Trend Join L/S v2f - hybrid build combining v2e's high-frequency 15m
// breakout entries with the Daily pivot-structure + SMA-slope trend GATE
// (originally from TJL v3 / SMC Phase 2), replacing v2e's lagging SMA200
// filter with the same cheap-per-bar STATE check used there.
//
// Rationale (state vs event distinction established this session): a
// zone-retest/setup is a rare EVENT - gating entries on it caps frequency
// no matter the timeframe (SMC Phase 1/2, TJL v3 all converged on this).
// Trend structure (confirmed pivot HH/HL or LH/LL + SMA slope) is a STATE -
// true or false on effectively every bar, cheap to check constantly. v2e
// already proved high-frequency + decent quality is achievable when
// entries come from a frequent mechanical trigger (15m breakout) and only
// DIRECTION is gated by a Daily-level condition. This variant swaps that
// gate from a lagging SMA200 level-check to the sharper structure-based
// state-check validated in SMC Phase 2 and the v2e Short diagnostic.
//
// GATE, applied SYMMETRICALLY:
//   allowLong  = structureUp   and slopeRising   (confirmed HH+HL, SMA50 rising)
//   allowShort = structureDown and slopeFalling  (confirmed LH+LL, SMA50 falling)
// Unclear/chop structure (neither Up nor Down) blocks BOTH sides - the bot
// sits out entirely rather than picking a side by default, unlike v2e's
// SMA200 check which is always resolvable one way or the other.
//
// Everything else (15m breakout trigger, ATR buffer on Short, fixed R:R
// exit at rrMult=2.25, initialStopAtrMult=1.5) is unchanged from v2e.
// =============================================================================

// ---- Inputs ----
grpExit = "Exit Settings"
atrLen             = input.int(14, "ATR Length", group=grpExit)
initialStopAtrMult = input.float(1.5, "Initial Stop - ATR Multiplier (defines R)", minval=0.1, step=0.1, group=grpExit)
rrMult             = input.float(2.25, "Take-Profit R:R Multiple", minval=0.1, step=0.1, group=grpExit)

grpTrend = "Daily Trend Structure Gate"
pivotLen      = input.int(3, "Pivot Lookback (bars each side)", minval=1, group=grpTrend)
smaLen        = input.int(50, "SMA Length (slope filter)", minval=2, group=grpTrend)
slopeLookback = input.int(10, "SMA Slope Lookback (bars)", minval=1, group=grpTrend)

grpShort = "Short Entry Filter"
bufferMult = input.float(0.5, "Intraday Breakdown - ATR Buffer Multiplier", minval=0.0, step=0.05, group=grpShort)

// ---- Daily-context data (previous COMPLETED daily bar only, no repainting) ----
dHigh1 = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
dLow1  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)

// ---- Daily trend-structure gate, computed entirely inside the "D" context
// so pivot state persists correctly across daily bars, then offset [1] for
// the same non-repainting previous-completed-bar convention as dHigh1/dLow1. ----
f_trendGate() =>
    phVal = ta.pivothigh(pivotLen, pivotLen)
    plVal = ta.pivotlow(pivotLen, pivotLen)
    var float lastPH = na
    var float prevPH = na
    var float lastPL = na
    var float prevPL = na
    if not na(phVal)
        prevPH := lastPH
        lastPH := phVal
    if not na(plVal)
        prevPL := lastPL
        lastPL := plVal
    structureUp = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and
         lastPH > prevPH and lastPL > prevPL
    structureDown = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and
         lastPH < prevPH and lastPL < prevPL
    smaVal = ta.sma(close, smaLen)
    slopeRising = smaVal > smaVal[slopeLookback]
    slopeFalling = smaVal < smaVal[slopeLookback]
    allowLongVal = structureUp and slopeRising
    allowShortVal = structureDown and slopeFalling
    [allowLongVal[1], allowShortVal[1]]

[allowLongDaily, allowShortDaily] = request.security(syminfo.tickerid, "D", f_trendGate(), lookahead=barmerge.lookahead_off)

// ---- Intraday session high/low since 00:00 UTC today (15m timeframe) ----
// Unchanged from v2e.
utcYear  = year(time, "UTC")
utcMonth = month(time, "UTC")
utcDay   = dayofmonth(time, "UTC")
newUtcDay = utcDay != utcDay[1] or utcMonth != utcMonth[1] or utcYear != utcYear[1]

var float sessionHigh = na
var float sessionLow  = na
if newUtcDay
    sessionHigh := na
    sessionLow  := na

sessionHighExclCurrent = sessionHigh
sessionLowExclCurrent  = sessionLow
sessionHigh := math.max(nz(sessionHigh, high), high)
sessionLow  := math.min(nz(sessionLow, low), low)

// ---- Entry logic: v2e's breakout trigger, now gated by Daily trend
// structure instead of SMA200. ----
currPx = close
atrVal = ta.atr(atrLen)

dailyBreakout    = currPx > dHigh1 and allowLongDaily
intradayBreakout = not na(sessionHighExclCurrent) and currPx > sessionHighExclCurrent
longCondition    = dailyBreakout and intradayBreakout

dailyBreakdown = currPx < dLow1 and allowShortDaily
intradayBreakdown = not na(sessionLowExclCurrent) and not na(atrVal) and
     currPx < sessionLowExclCurrent - bufferMult * atrVal
shortCondition = dailyBreakdown and intradayBreakdown

flat = strategy.position_size == 0

// ---- Exit logic: FIXED stop + take-profit bracket, unchanged from v2e. ----
if flat and longCondition and not na(atrVal)
    strategy.entry("Long", strategy.long)
    rDist = initialStopAtrMult * atrVal
    stopPrice = currPx - rDist
    tpPrice   = currPx + rrMult * rDist
    strategy.exit("Exit Long", "Long", stop=stopPrice, limit=tpPrice)
else if flat and shortCondition and not na(atrVal)
    strategy.entry("Short", strategy.short)
    rDist = initialStopAtrMult * atrVal
    stopPrice = currPx + rDist
    tpPrice   = currPx - rrMult * rDist
    strategy.exit("Exit Short", "Short", stop=stopPrice, limit=tpPrice)

// ---- Plots ----
plot(dHigh1, "Prev Daily High", color=color.new(color.red, 0), style=plot.style_stepline)
plot(dLow1, "Prev Daily Low", color=color.new(color.green, 0), style=plot.style_stepline)
plot(sessionHigh, "Session High (today, UTC)", color=color.new(color.orange, 0), style=plot.style_stepline)
plot(sessionLow, "Session Low (today, UTC)", color=color.new(color.purple, 0), style=plot.style_stepline)

plotshape(flat and longCondition, title="Long Entry",
     location=location.belowbar, style=shape.triangleup, color=color.new(color.lime, 0), size=size.small)
plotshape(flat and shortCondition, title="Short Entry",
     location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 0), size=size.small)

alertcondition(flat and longCondition, title="TJL Long Entry",
     message="Trend Join Long/Short v2f: BTCUSDT trend-gated long entry conditions met")
alertcondition(flat and shortCondition, title="TJL Short Entry (trend-gated)",
     message="Trend Join Long/Short v2f: BTCUSDT trend-gated short entry conditions met")

// ---- Debug: per-side breakdown via legend/data_window (temporary, same
// technique used throughout this session). ----
longTrades = 0
longWins = 0
longGP = 0.0
longGL = 0.0
shortTrades = 0
shortWins = 0
shortGP = 0.0
shortGL = 0.0

for i = 0 to strategy.closedtrades - 1
    isLongT = strategy.closedtrades.size(i) > 0
    profit = strategy.closedtrades.profit(i)
    if isLongT
        longTrades += 1
        if profit > 0
            longWins += 1
            longGP += profit
        else
            longGL += -profit
    else
        shortTrades += 1
        if profit > 0
            shortWins += 1
            shortGP += profit
        else
            shortGL += -profit

longPF = longGL > 0 ? longGP / longGL : 0.0
shortPF = shortGL > 0 ? shortGP / shortGL : 0.0
longWinPct = longTrades > 0 ? longWins / longTrades * 100 : 0.0
shortWinPct = shortTrades > 0 ? shortWins / shortTrades * 100 : 0.0

plot(longTrades, "Z_LongTrades", display=display.data_window)
plot(longWinPct, "Z_LongWinPct", display=display.data_window)
plot(longPF, "Z_LongPF", display=display.data_window)
plot(shortTrades, "Z_ShortTrades", display=display.data_window)
plot(shortWinPct, "Z_ShortWinPct", display=display.data_window)
plot(shortPF, "Z_ShortPF", display=display.data_window)
